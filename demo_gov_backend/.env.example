# FSFVI Demo Government Backend Environment Configuration
# This backend serves as the authentication and API proxy for government developers

# ============================================================================
# Environment Mode
# ============================================================================
# Options: development, production
ENVIRONMENT=development

# ============================================================================
# Server Configuration
# ============================================================================
HOST=127.0.0.1
PORT=8081

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=sqlite:./demo_gov_backend.db

# ============================================================================
# Security Configuration
# ============================================================================
JWT_SECRET=your-extremely-secure-jwt-secret-key-for-kenya-government-change-this-immediately

# ============================================================================
# FSFVI API Configuration
# ============================================================================
# Main FSFVI API endpoint (where the actual FSFVI calculations happen)
# Development: Point to local FSFVI backend
# Production: Point to production FSFVI backend
FSFVI_API_URL=http://localhost:8080

# API Key for this demo backend to authenticate with main FSFVI API
# In production, this should be a dedicated API key for the demo backend
FSFVI_API_KEY=fsfi_live_8Smv8OP90QFEJXhYwifC6BfmWhzonjnk

# ============================================================================
# CORS Configuration
# ============================================================================
# Frontend URLs that can access this backend
# Development
CORS_ORIGIN_DEV=http://localhost:3000
# Production
CORS_ORIGIN_PROD=https://demo.fsfvi.ai

# ============================================================================
# Logging Configuration
# ============================================================================
# Options: trace, debug, info, warn, error
RUST_LOG=info

# ============================================================================
# Rate Limiting (for demo purposes)
# ============================================================================
# Max requests per minute per user
RATE_LIMIT_PER_MINUTE=60
