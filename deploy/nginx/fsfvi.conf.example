# Example nginx site for Rwanda FSFI (Django + Next.js on same host).
# This file is included inside nginx's `http { }` context (e.g. sites-available).
# Adjust paths, server_name, and upstream port. Then:
#   sudo ln -s /etc/nginx/sites-available/fsfvi /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# TLS: sudo certbot --nginx -d rwanda.fsfvi.ai -d fsfvi.ai
# Django SECURE_PROXY_SSL_HEADER requires X-Forwarded-Proto (set below).

limit_req_zone $binary_remote_addr zone=fsfvi_api:10m rate=10r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream fsfvi_django {
    server unix:/run/fsfvi/gunicorn.sock fail_timeout=0;
}

upstream fsfvi_nextjs {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name rwanda.fsfvi.ai fsfvi.ai;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name rwanda.fsfvi.ai fsfvi.ai;

    ssl_certificate     /etc/letsencrypt/live/rwanda.fsfvi.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rwanda.fsfvi.ai/privkey.pem;

    # Strong defaults; certbot may add: include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    location /api/ {
        limit_req zone=fsfvi_api burst=30 nodelay;
        proxy_pass http://fsfvi_django;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    location /admin/ {
        proxy_pass http://fsfvi_django;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /static/ {
        alias /opt/fsfvi/app/rwanda_backend/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Next.js (Node). Static export: replace with root + try_files (see deployment guide).
    location / {
        proxy_pass http://fsfvi_nextjs;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}
