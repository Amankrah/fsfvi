# FSFI production nginx site (Django Gunicorn + Next.js on one host).
#
# Intended to be copied as-is — no local editing — when your stack matches:
#   • App root:     /opt/fsfvi/app
#   • Gunicorn:     unix:/run/fsfvi/gunicorn.sock  (see systemd in docs/PRODUCTION_DEPLOYMENT.md)
#   • Next.js:      127.0.0.1:3000
#   • Static files: django collectstatic → rwanda_backend/staticfiles/
#   • Hostnames:    rwanda.fsfvi.ai  fsfvi.ai
#   • TLS:          Let’s Encrypt; first -d name becomes the live/ folder (use rwanda first):
#       sudo certbot certonly --webroot -w /var/www/html \
#         -d rwanda.fsfvi.ai -d fsfvi.ai
#     Then paths below (/etc/letsencrypt/live/rwanda.fsfvi.ai/) match.
#
# Deploy:
#   sudo cp /opt/fsfvi/app/deploy/nginx/fsfvi.conf.example /etc/nginx/sites-available/fsfvi
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo ln -sf /etc/nginx/sites-available/fsfvi /etc/nginx/sites-enabled/fsfvi
#   sudo nginx -t && sudo systemctl reload nginx
#
# Requires: package certbot creates options-ssl-nginx.conf (e.g. apt install python3-certbot-nginx).
# Django settings_production: SECURE_PROXY_SSL_HEADER — keep X-Forwarded-Proto below.

limit_req_zone $binary_remote_addr zone=fsfvi_api:10m rate=10r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream fsfvi_django {
    server unix:/run/fsfvi/gunicorn.sock fail_timeout=0;
}

upstream fsfvi_nextjs {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name rwanda.fsfvi.ai fsfvi.ai;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name rwanda.fsfvi.ai fsfvi.ai;

    ssl_certificate     /etc/letsencrypt/live/rwanda.fsfvi.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rwanda.fsfvi.ai/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    server_tokens off;
    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # Normalize bare paths (Django expects trailing slash for /admin/ and /api/)
    location = /admin {
        return 301 https://$host/admin/;
    }
    location = /api {
        return 301 https://$host/api/;
    }

    location /api/ {
        limit_req zone=fsfvi_api burst=30 nodelay;
        proxy_pass http://fsfvi_django;
        proxy_set_header Host               $host;
        proxy_set_header X-Forwarded-Host   $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_redirect off;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    location /admin/ {
        limit_req zone=fsfvi_api burst=20 nodelay;
        proxy_pass http://fsfvi_django;
        proxy_set_header Host               $host;
        proxy_set_header X-Forwarded-Host   $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    location /static/ {
        alias /opt/fsfvi/app/rwanda_backend/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://fsfvi_nextjs;
        proxy_http_version 1.1;
        proxy_set_header Host               $host;
        proxy_set_header X-Forwarded-Host   $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
        proxy_set_header Upgrade            $http_upgrade;
        proxy_set_header Connection         $connection_upgrade;
    }
}
