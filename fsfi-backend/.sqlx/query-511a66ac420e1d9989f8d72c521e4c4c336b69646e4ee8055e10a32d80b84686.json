  "db_name": "PostgreSQL",
  "query": "\n                    SELECT\n                        ak.id,\n                        ak.government_id,\n                        ak.status as \"status: ApiKeyStatus\",\n                        ak.scopes,\n                        ak.expires_at,\n                        g.status as \"gov_status: crate::models::government::GovernmentStatus\"\n                    FROM api_keys ak\n                    JOIN governments g ON ak.government_id = g.id\n                    WHERE ak.key_hash = $1\n                    ",
