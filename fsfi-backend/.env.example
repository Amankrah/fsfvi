# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,fsfi_backend=debug

# Database Configuration
DATABASE_URL=postgresql://fsfi_user:secure_password@localhost:5432/fsfi_db
DATABASE_MAX_CONNECTIONS=10

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=3600  # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRY=2592000  # 30 days in seconds

# Security
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
MAX_REQUEST_SIZE=10485760  # 10MB in bytes

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Government API Keys Encryption
ENCRYPTION_KEY=your-encryption-key-for-api-keys-32-bytes-minimum

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# AWS Configuration (for CloudWatch logs)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
