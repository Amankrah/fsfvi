# Development Environment Configuration
# DO NOT use these settings in production!

# Server Configuration
HOST=127.0.0.1
PORT=8080
RUST_LOG=debug,fsfi_backend=debug,actix_web=info

# Database Configuration (Local PostgreSQL)
DATABASE_URL=postgres://fsfi_dev:dev_password_123@localhost:5433/fsfi_dev_db
DATABASE_MAX_CONNECTIONS=5

# JWT Configuration (Development keys - NOT FOR PRODUCTION)
JWT_SECRET=dev_jwt_secret_key_change_this_in_production_min_32_chars
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
MAX_REQUEST_SIZE=10485760

# Rate Limiting (More lenient for dev)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=200

# Government API Keys Encryption (Development key)
ENCRYPTION_KEY=dev_encryption_key_min_32_chars_change_in_production

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# AWS Configuration (Optional for local dev)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
