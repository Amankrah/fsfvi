# Production Environment Configuration
# IMPORTANT: Generate secure secrets before deploying!

# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,fsfi_backend=info

# Database Configuration (Production PostgreSQL)
DATABASE_URL=postgresql://fsfi_prod_user:CHANGE_THIS_PASSWORD@prod-db-host:5432/fsfi_prod_db
DATABASE_MAX_CONNECTIONS=20

# JWT Configuration
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_64_CHARS
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000

# Security
ALLOWED_ORIGINS=https://your-production-domain.com,https://api.your-domain.com
MAX_REQUEST_SIZE=10485760

# Rate Limiting (Strict for production)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Government API Keys Encryption
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_32_CHARS

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# AWS Configuration (for CloudWatch logs)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
