# Rwanda FSFI Frontend Environment Configuration
# ================================================
# Copy this file to .env.local and update values

# Rwanda Django Backend API URL
# Default: http://localhost:8000 (Django dev server)
# Production: https://api.fsfvi.minagri.gov.rw
NEXT_PUBLIC_RWANDA_API_URL=http://localhost:8000

# Application Configuration
NEXT_PUBLIC_APP_NAME="Rwanda FSFI Dashboard"
NEXT_PUBLIC_APP_URL=http://localhost:3001
