# Copy to .env and adjust. Loaded automatically by manage.py / wsgi / asgi (see env_bootstrap.py).
#
# Settings module (same pattern as Next.js NODE_ENV + .env.local vs .env.production):
#   Local dev:        rwanda_project.settings (default if omitted)
#   Production EC2:   rwanda_project.settings_production

DJANGO_SETTINGS_MODULE=rwanda_project.settings

# --- Common (both environments) ---
# DJANGO_SECRET_KEY=
# FSFI_JWT_SECRET=
# FSFI_ENCRYPTION_KEY=

# --- Local dev (settings) ---
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# CSRF_TRUSTED_ORIGINS=   # optional; defaults to same as CORS

# --- Production only (settings_production) — set when DJANGO_SETTINGS_MODULE=rwanda_project.settings_production ---
# DJANGO_DEBUG=False
# List every hostname nginx uses (no https://) — subdomain + apex if both point at the app:
# DJANGO_ALLOWED_HOSTS=rwanda.fsfvi.ai,fsfvi.ai,13.63.119.228
# DJANGO_SECURE_SSL_REDIRECT=true
# List every browser origin that loads the Next.js app (https://, comma-separated) — MUST include your subdomain:
# CORS_ALLOWED_ORIGINS=https://rwanda.fsfvi.ai,https://fsfvi.ai
# CSRF_TRUSTED_ORIGINS=https://rwanda.fsfvi.ai,https://fsfvi.ai
# DB_NAME=/var/lib/fsfvi/db.sqlite3
